{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frienddrop",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "TURN_BUDGET", "class_name": "TurnBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["TurnBudget"] }],
  "ratelimits": [{ "name": "REQUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "vars": {
    "TURN_MONTHLY_ROOM_LIMIT": "40",
    "ALLOWED_ORIGINS": "https://shuaigaodada.github.io,http://localhost:8787,http://127.0.0.1:8787",
    "STUN_URL": "stun:stun.cloudflare.com:3478"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
